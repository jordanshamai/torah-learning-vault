filters:
  and:
    - file.inFolder("Loshon Hakodesh")
    - file.ext == "md"
properties:
  file.name:
    displayName: Definition
  note.masc:
    displayName: M (s.)
  note.fem:
    displayName: F (s.)
  note.masc_pl:
    displayName: M (pl.)
  note.fem_pl:
    displayName: F (pl.)
  note.infinitive:
    displayName: Infinitive
  note.type:
    displayName: Type
  note.page:
    displayName: Page
  note.lesson:
    displayName: Lesson
  note.number:
    displayName: "#"
  note.date:
    displayName: Date
views:
  - type: table
    name: Lessons
    filters:
      and:
        - file.inFolder("Loshon Hakodesh/Lessons")
    order:
      - note.number
      - file.name
      - note.date
    sort:
      - property: note.number
        direction: ASC
  - type: table
    name: All Words
    filters:
      and:
        - file.inFolder("Loshon Hakodesh/Words")
    order:
      - file.name
      - note.masc
      - note.fem
      - note.masc_pl
      - note.fem_pl
      - note.infinitive
      - note.type
      - note.lesson
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: By Lesson
    filters:
      and:
        - file.inFolder("Loshon Hakodesh/Words")
    groupBy:
      property: note.lesson
      direction: ASC
    order:
      - file.name
      - note.masc
      - note.fem
      - note.masc_pl
      - note.fem_pl
      - note.infinitive
      - note.type
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: This Lesson
    filters:
      and:
        - file.inFolder("Loshon Hakodesh/Words")
        - file.hasLink(this.file)
    order:
      - file.name
      - note.masc
      - note.fem
      - note.masc_pl
      - note.fem_pl
      - note.infinitive
      - note.type
    sort:
      - property: file.name
        direction: ASC
